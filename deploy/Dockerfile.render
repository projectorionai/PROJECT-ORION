# Disposable Render Free trial. The Blueprint selects this image explicitly.
# No desktop state, credentials, private plugins or Android APKs are included.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libegl1 libxkbcommon0 libdbus-1-3 libfontconfig1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --user-group orion

WORKDIR /app
COPY deploy/requirements-server.txt /app/deploy/requirements-server.txt
RUN pip install --no-cache-dir -r deploy/requirements-server.txt

COPY orion.py /app/orion.py
COPY orion_core /app/orion_core
COPY config/knowledge_packs /app/config/knowledge_packs
COPY deploy/render_entrypoint.py /app/deploy/render_entrypoint.py
RUN mkdir -p /app/data/config /app/research /app/reports /app/logs /app/conversations \
    && chown -R orion:orion /app/data /app/research /app/reports /app/logs /app/conversations

ENV QT_QPA_PLATFORM=offscreen \
    ORION_CONFIG_DIR=/app/data/config \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER orion
EXPOSE 10000
CMD ["python", "deploy/render_entrypoint.py"]
