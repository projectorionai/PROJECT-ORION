# systemd unit for the O.R.I.O.N. headless node (bare-metal, no Docker).
# Install on the Oracle Cloud VM:
#   sudo cp deploy/orion-node.service /etc/systemd/system/orion-node.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now orion-node
#   journalctl -u orion-node -f          # follow the log
#
# Assumes the repo lives at /opt/orion with a venv at /opt/orion/.venv.

[Unit]
Description=O.R.I.O.N. headless AI node (remote uplink)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orion
Group=orion
WorkingDirectory=/opt/orion
Environment=ORION_HEADLESS=1
Environment=QT_QPA_PLATFORM=offscreen
Environment=ORION_REMOTE_HOST=127.0.0.1
Environment=ORION_REMOTE_PORT=8765
# Put provider keys in /opt/orion/config/api_keys.json, or add them here:
# Environment=ORION_MODE=auto
# Everything the node writes lives in these directories. They are made
# ("+": outside the sandbox) before the sandbox is set up, because systemd
# will not start a unit whose ReadWritePaths entry is missing.
ExecStartPre=+/usr/bin/install -d -o orion -g orion /opt/orion/config /opt/orion/conversations /opt/orion/research /opt/orion/reports /opt/orion/exports /opt/orion/logs
ExecStart=/opt/orion/.venv/bin/python /opt/orion/orion.py --headless
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# conversations/ holds the transcripts: without it every remote turn's
# history was silently lost, and recalling past conversations found nothing.
ReadWritePaths=/opt/orion/config /opt/orion/conversations /opt/orion/research /opt/orion/reports /opt/orion/exports /opt/orion/logs
ProtectHome=true

[Install]
WantedBy=multi-user.target
