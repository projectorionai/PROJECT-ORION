{
  "name": "jv_quiz",
  "description": "Run a persistent quiz one question at a time. Grade exact choice answers and explicitly mark alternative/open answers for judgement.",
  "module": "jv_quiz_tool.py",
  "version": "33.0.0",
  "tier": "allow",
  "permissions": [
    "filesystem"
  ],
  "requires": [],
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "The action to perform.",
        "enum": [
          "start",
          "answer",
          "grade",
          "status",
          "results",
          "stop"
        ]
      },
      "topic": {
        "type": "string",
        "description": "Subject or title."
      },
      "questions": {
        "type": "array",
        "description": "One to twenty questions for start.",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Question format.",
              "enum": [
                "multiple_choice",
                "true_false",
                "fill_blank",
                "open"
              ]
            },
            "question": {
              "type": "string",
              "description": "Question wording."
            },
            "answer": {
              "type": "string",
              "description": "Reference answer."
            },
            "explanation": {
              "type": "string",
              "description": "Explanation after answering."
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Choice labels."
            }
          },
          "required": [
            "question",
            "answer"
          ]
        }
      },
      "answer": {
        "type": "string",
        "description": "The user's answer to the current question."
      },
      "index": {
        "type": "integer",
        "description": "One-based answered question index, for manual grading."
      },
      "correct": {
        "type": "boolean",
        "description": "Manual judgement of an answered open question."
      }
    },
    "required": [
      "action"
    ]
  },
  "secrets": []
}
