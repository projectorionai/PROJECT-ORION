{
  "name": "orion_batch_planner",
  "description": "Plan supplied task dependencies, grouping independent read/compute tasks and serialising side effects. Produces a proposal only; executes nothing.",
  "parameters": {
    "type": "object",
    "properties": {
      "tasks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "read",
                "compute",
                "write",
                "external",
                "destructive",
                "unknown"
              ]
            },
            "depends_on": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string"
              }
            },
            "estimate_ms": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "max_concurrency": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      }
    },
    "required": [
      "tasks"
    ]
  },
  "module": "orion_batch_planner_tool.py",
  "tier": "allow",
  "requires": [],
  "permissions": [],
  "version": "1.0.0"
}
