# O.R.I.O.N. environment reference — export the variables you want to use.
# ORION does not automatically load .env files. Use your shell/environment
# manager, or configure providers through the app's API-key settings.
# Contains NO real secrets. `.env` itself is gitignored; this template is not.
# All values are optional; ORION runs with safe defaults when unset.

# ── Provider API keys (secrets — never commit real values) ───────────────────
# Leave blank to disable a provider. Keys also live in config/api_keys.json.
ORION_GEMINI_API_KEY=
ORION_ANTHROPIC_API_KEY=
ORION_OPENAI_API_KEY=
ORION_XAI_API_KEY=
ORION_OPENROUTER_API_KEY=
ORION_GROQ_API_KEY=
ORION_TOGETHER_API_KEY=

# Local OpenAI-compatible LLM (Ollama / LM Studio). No key needed.
ORION_LOCAL_OPENAI_BASE_URL=

# ── Routing / mode ───────────────────────────────────────────────────────────
# auto (default) | cloud (force cloud) | offline (force local)
ORION_MODE=auto
# Tie-breaker within auto mode: local | cloud
ORION_PREFER=

# ── Retry / circuit-breaker / timeouts (Section 12) ──────────────────────────
ORION_RETRY_MAX=3
ORION_RETRY_BASE_DELAY=0.5
ORION_RETRY_MAX_DELAY=12.0
ORION_CB_THRESHOLD=3
ORION_CB_COOLDOWN=45
ORION_TIMEOUT_CONNECT=30
ORION_TIMEOUT_READ=45

# ── Globe max-zoom safeguards (Section 1) ────────────────────────────────────
ORION_GLOBE_ZOOM_MAX_ATTEMPTS=40
ORION_GLOBE_ZOOM_MAX_SECONDS=20
ORION_GLOBE_ZOOM_DELAY_S=0.05

# ── Resource-pressure monitor thresholds (Section 8) ─────────────────────────
ORION_RES_CPU_ELEVATED=85
ORION_RES_CPU_CRITICAL=95
ORION_RES_MEM_ELEVATED=85
ORION_RES_MEM_CRITICAL=95
ORION_RES_ELEVATED_HOLD_S=20
ORION_RES_CRITICAL_HOLD_S=10

# ── Destructive-action confirmation (Section 10) ─────────────────────────────
# Seconds a shutdown/restart/delete confirmation stays valid before expiring.
ORION_CONFIRM_TTL=60

# ── Telemetry retention (Section 6/12) ───────────────────────────────────────
ORION_TELEMETRY_RETENTION_DAYS=90
ORION_TELEMETRY_MAX_LOG_LINES=5000

# ── Misc runtime toggles ─────────────────────────────────────────────────────
# Wake-word standby (1 to require "Orion" before listening).
ORION_WAKE_MODE=
# Disable the autonomous self-improvement heartbeat with 0.
ORION_SELF_IMPROVE=1
